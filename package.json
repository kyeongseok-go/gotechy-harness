{
  "name": "gotechy-harness",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "Gotechy Harness v2 — 파일 계약 기반 멀티 에이전트 작업 위임 CLI",
  "type": "module",
  "bin": {
    "gotechy": "src/cli.ts"
  },
  "scripts": {
    "gotechy": "bun src/cli.ts",
    "dev": "bun src/cli.ts",
    "test": "bun src/cli.ts test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/gotechy",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:boundaries": "bun test tests/boundaries",
    "gen:docs": "bun scripts/gen-docs.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "hono": "4.13.13",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
